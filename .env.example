# Instance files are stored in ARCH_QEMU_STORAGE_ROOT\ARCH_QEMU_VM_NAME.
ARCH_QEMU_STORAGE_ROOT=C:\VMs
ARCH_QEMU_VM_NAME=ArchHyprland

# desktop, start-menu, or none. Shortcut name follows ARCH_QEMU_VM_NAME.
ARCH_QEMU_SHORTCUT=desktop

# Per-device QEMU resources
ARCH_QEMU_CPUS=8
ARCH_QEMU_MEMORY_MIB=6144
ARCH_QEMU_DISK_GIB=64
ARCH_QEMU_GPU_HOSTMEM_GIB=4
ARCH_QEMU_VIDEO_MODE=virgl
ARCH_QEMU_FULLSCREEN=true

# Guest setup
ARCH_QEMU_GUEST_USER=nwassom
ARCH_QEMU_TIMEZONE=America/New_York
ARCH_QEMU_DOTFILES_REF=main
ARCH_HYPRLAND_SCALE=1.5
